flowchart LR
  Q{인용이 원문에 있나} -- 있음 --> F[strength · 판정 확정]
  Q -- 없음 --> R[그 항목만 고쳐 쓰기]
  R --> F
  R -.그래도 없음.-> D[항목 제거] --> F
  F --> V{검증}
  V -- passed --> L[(적재)]
  V -- failed --> S[적재 안 함]
  classDef code fill:#EEF3FF,stroke:#1B4FD8,stroke-width:2px,color:#111721
  classDef llm fill:#1B4FD8,stroke:#143BA6,stroke-width:2px,color:#FFFFFF
  classDef fb fill:#F3F5F8,stroke:#1B4FD8,stroke-width:2px,color:#111721
  classDef stop fill:#FFFFFF,stroke:#3F4753,stroke-width:2px,stroke-dasharray:5 4,color:#111721
  class Q,F,V,L code
  class R llm
  class D fb
  class S stop
